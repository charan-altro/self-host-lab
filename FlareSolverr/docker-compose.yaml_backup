version: "3"

services:
  # FlareSolverr bypasses Cloudflare browser checks for torrent domains
  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ=Asia/Kolkata
    ports:
      - "8191:8191"
    networks:
      - frontend
    restart: unless-stopped

networks:
  frontend:
    external: true
