services:
  jellyfin:
    image: jellyfin/jellyfin:latest
    dns:
      - 8.8.8.8
      - 1.1.1.1
    container_name: jellyfin
    privileged: true
    ports:
      - "8096:8096"
    devices:
      - /dev/vchiq:/dev/vchiq
      - /dev/video10:/dev/video10
      - /dev/video11:/dev/video11
      - /dev/video12:/dev/video12
    volumes:
      #- /srv/jellyfin/config:/config
      - /mnt/raksha/jellyfin_config:/config
      # - /srv/jellyfin/cache:/cache  <-- OLD (SD Card)
      - type: tmpfs                     # <-- NEW (RAM Disk)
        target: /cache
        tmpfs:
          size: 1024M                   # Limits RAM usage to 1GB (plenty for audio)
      - /mnt/raksha:/media
    environment:
      - PUID=1000
      - PGID=1000
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin-https.rule=Host(`jellypin.jedarabale.space`)"
      - "traefik.http.routers.jellyfin-https.entrypoints=websecure"
      - "traefik.http.routers.jellyfin-https.service=jellyfin"
      - "traefik.http.routers.jellyfin-https.tls.certresolver=cloudflare"
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
    networks:
      - frontend
    restart: unless-stopped

networks:
  frontend:
    external: true
