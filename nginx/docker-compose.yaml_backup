---
services:
  nginx:
    image: nginx:latest
    container_name: nginx
    volumes:
      - ./config/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./html:/usr/share/nginx/html:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.nginx-test-http.entrypoints=web"
      - "traefik.http.routers.nginx-test-http.rule=Host(`nginx-test.jedarabale`)"
      - "traefik.http.routers.nginx-test-https.entrypoints=websecure"
      - "traefik.http.routers.nginx-test-https.rule=Host(`nginx-test.jedarabale`)"
      - "traefik.http.routers.nginx-test-https.tls=true"
      - "traefik.http.routers.nginx-test-https.tls.certresolver=cloudflare"
    networks:
      - frontend
    restart: unless-stopped

networks:
  frontend:
    external: true

