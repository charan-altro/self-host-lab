version: '3.8'

services:
  pihole:
    container_name: pihole
    image: pihole/pihole:latest
    hostname: pihole
    networks:
      - frontend          # same network Traefik uses
    ports:
      # DNS ports (must be on host)
      - "53:53/tcp"
      - "53:53/udp"
      # If you also want to reach the UI directly via IP instead of Traefik, you can expose 8080->80
      - "8080:80/tcp"
    env_file:
      - .env
    environment:
      TZ: 'Asia/Kolkata'
      # Set admin password
      FTLCONF_webserver_api_password=${PIHOLE_PASSWORD}
      # Listen on all interfaces (common when using bridge networking)
      FTLCONF_dns_listeningMode: 'ALL'
    volumes:
      - ./etc-pihole:/etc/pihole
      # Uncomment if you need custom dnsmasq configs
      # - ./etc-dnsmasq.d:/etc/dnsmasq.d
    labels:
      - "traefik.enable=true"

      # HTTPS router via your existing websecure entrypoint + Cloudflare resolver
      - "traefik.http.routers.pihole-https.rule=Host(`pihole.jedarabale`)"
      - "traefik.http.routers.pihole-https.entrypoints=websecure"
      - "traefik.http.routers.pihole-https.tls.certresolver=cloudflare"

      # Pi-hole's UI is on port 80 inside the container
      - "traefik.http.services.pihole.loadbalancer.server.port=80"

      # Optional: always redirect to /admin
      - "traefik.http.middlewares.pihole-prefix.addPrefix.prefix=/admin"
      - "traefik.http.routers.pihole-https.middlewares=pihole-prefix"

    #cap_add:
      # Only needed if you plan to use Pi-hole as DHCP or NTP
      # - NET_ADMIN
      # - SYS_TIME
      # - SYS_NICE
    restart: unless-stopped

networks:
  frontend:
    external: true
